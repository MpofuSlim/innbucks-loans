# Copy to .env and fill in real values: `cp .env.example .env`
# .env is gitignored — never commit real secrets.

# ─── PostgreSQL (consumed by docker-compose.yml) ───────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bulkit_loans

# ─── Application secrets ───────────────────────────────────────────────────
# These back the ${...} placeholders in each module's application.properties.
# They default to empty, so the app starts without them, but the matching
# integration (InnBucks / Ndasenda / Keycloak / notifications) stays inert
# until set. Provide them via your shell, CI secrets, or the container's
# external config (the images load /app/config). Leave blank here.

# AES key material (currently unused by code; kept for forward-compat)
ENCRYPTION_KEY=
ENCRYPTION_KEY_V2=

# Ndasenda deductions API
NDASENDA_USERNAME=
NDASENDA_PASSWORD=
NDASENDA_SECURITY_CODE=
NDASENDA_DEDUCTION_CODE=

# InnBucks API (INNBUCKS_BASE_URL defaults to the staging gateway)
INNBUCKS_USERNAME=
INNBUCKS_PASSWORD=
INNBUCKS_API_KEY=
#INNBUCKS_BASE_URL=https://staging.innbucks.co.zw

# Notification API (NOTIFICATION_USERNAME has a default)
#NOTIFICATION_USERNAME=autoloan@bulkit.co.zw
NOTIFICATION_PASSWORD=

# Keycloak / Bulkit auth (AUTH_URL, REALM, USERNAME have defaults)
BULKIT_CLIENT_ID=
BULKIT_CLIENT_SECRET=
BULKIT_PASSWORD=
#BULKIT_AUTH_URL=http://localhost:8380
#BULKIT_REALM=bulkit-loans-prod-realm
#BULKIT_USERNAME=admin

# loans-embedded-ui only
BULKIT_LOANS_CHANNEL_ID=
