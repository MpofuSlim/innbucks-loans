# Copy to .env and fill in real values: `cp .env.example .env`
# .env is gitignored — never commit real secrets.

# ─── PostgreSQL (consumed by docker-compose.yml) ───────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=innbucks_loans

# ─── Application secrets ───────────────────────────────────────────────────
# These back the ${...} placeholders in loans-api's application.yml.
# They default to empty, so the app starts without them, but the matching
# integration (InnBucks / Ndasenda) stays inert
# until set. Provide them via your shell, CI secrets, or the container's
# external config (the images load /app/config). Leave blank here.

# Ndasenda deductions API
NDASENDA_USERNAME=
NDASENDA_PASSWORD=
NDASENDA_SECURITY_CODE=
NDASENDA_DEDUCTION_CODE=

# InnBucks API (INNBUCKS_BASE_URL defaults to the staging gateway)
INNBUCKS_USERNAME=
INNBUCKS_PASSWORD=
INNBUCKS_API_KEY=
#INNBUCKS_BASE_URL=https://staging.innbucks.co.zw
# InnBucks loan product code for pre-approved applications (defaults to NANOUS)
#INNBUCKS_LOAN_PRODUCT=NANOUS

# Bootstrap super-admin, created once on first boot with a temporary password
# (BOOTSTRAP_ADMIN_USERNAME defaults to admin)
BOOTSTRAP_ADMIN_PASSWORD=
#BOOTSTRAP_ADMIN_USERNAME=admin
