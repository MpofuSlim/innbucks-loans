<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath /> <!-- lookup parent from repository -->
    </parent>
    <groupId>zw.co.innbucks.loans</groupId>
    <artifactId>loans-api</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>loans-api</name>
    <description>loans-api</description>
    <properties>
        <java.version>21</java.version>
        <!-- CVE overrides of Spring Boot 4.1.1's BOM. This module builds the image's jar, so its
             values are what ships; loans-core/pom.xml carries the same three so its tests run on
             the same versions. Change them together.

             Tomcat: the BOM manages 11.0.24, which carries three CRITICAL auth/access-control
             bypasses, CVE-2026-65182 (security constraint bypass), CVE-2026-65905 (DIGEST replay)
             and CVE-2026-68525 (FORM authentication bypass). 11.0.25 is the fix line.

             Jackson: the BOM manages 3.1.5 (tools.jackson, the app's JSON) and 2.21.5
             (com.fasterxml), which carry five HIGH denial-of-service CVEs: CVE-2026-89407 and
             CVE-2026-89425 in jackson-core, CVE-2026-68497, CVE-2026-91776 and CVE-2026-91777 in
             jackson-databind. 3.1.7 and 2.21.7 are the fix lines. Overriding the BOM properties
             moves each family as one aligned set; never pin core or databind alone.

             Each value MUST stay >= the BOM's own. On every Spring Boot bump, read the BOM and raise
             these or delete them once it is at or past the fix lines:
               V=4.1.1; curl -s "https://repo1.maven.org/maven2/org/springframework/boot/spring-boot-dependencies/$V/spring-boot-dependencies-$V.pom" | grep -E "tomcat.version|jackson" -->
        <tomcat.version>11.0.25</tomcat.version>
        <jackson-bom.version>3.1.7</jackson-bom.version>
        <jackson-2-bom.version>2.21.7</jackson-2-bom.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>zw.co.innbucks.loans</groupId>
            <artifactId>loans-core</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.1.1</version>
        </dependency>
        <!-- Health endpoints for the fleet cell's readiness and liveness probes, and /actuator/prometheus for the
             cell's Prometheus (application.yml exposes those two and nothing else). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Version managed by Spring Boot's dependency management. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- Distributed tracing, the fleet's convention (CLAUDE.md "Tracing"): Micrometer Tracing over the
             OpenTelemetry bridge, W3C traceparent. Ids are generated and continued from the gateway's
             traceparent; spans are exported over OTLP only when OTEL_EXPORTER_OTLP_TRACES_ENDPOINT names a
             collector (blank = nothing exported). spring-boot-micrometer-tracing-opentelemetry is the Boot 4
             auto-configuration module; versions are Boot-managed. Not spring-boot-starter-opentelemetry: it also
             brings micrometer-registry-otlp, which pushes metrics to localhost:4318 by default and logs a failure
             every step. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-micrometer-tracing-opentelemetry</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>
        <!-- Stubs the partner gateways in TracingTest, which proves they never receive traceparent. Same
             standalone (shaded) jar and version as loans-core's contract tests. -->
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>3.13.2</version>
            <scope>test</scope>
        </dependency>
        <!-- The *IT classes (run by failsafe at verify) against a real Postgres: a container where Docker is
             available (CI), or the server LOANS_IT_POSTGRES names (host:port). Version from Boot's
             testcontainers BOM. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <finalName>loans-api</finalName>
        <plugins>
            <!-- Lombok as an EXPLICIT processor path. From JDK 23 javac no longer runs an annotation processor it
                 merely finds on the classpath, so on the JDK the image and CI run (25) Lombok would silently stop
                 and every @Slf4j/@RequiredArgsConstructor class would fail to compile. <release> (from Boot's
                 maven.compiler.release, pinned here too) makes the bytecode genuinely target ${java.version}. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>${java.version}</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!-- Runs the *IT classes during `mvn verify` (surefire never picks them up). Without an execution bound
                 here they would compile and never run. They boot the application on a real Postgres and skip
                 themselves when neither Docker nor LOANS_IT_POSTGRES is available. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <executable>true</executable>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
