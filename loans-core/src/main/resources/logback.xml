<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Console only, like every fleet service: the platform collects stdout (docker logs on the box,
         kubectl logs in the cell). There is deliberately no file appender: the cell runs the image with a
         read-only root filesystem, where a file appender cannot create its directory and logback aborts
         the boot, and a file inside a container is lost with it anyway. -->
    <!-- [traceId,spanId] are Micrometer Tracing's MDC keys (CLAUDE.md "Tracing"): every line written inside a
         request or an @Async task carries the trace the gateway started, so one search follows a call across the
         fleet. Empty outside a trace (startup, a scheduled job before it starts its own span). -->
    <appender name="consoleAppender" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <Pattern>.%d{HH:mm:ss.SSS} %-5level [%X{traceId:-},%X{spanId:-}] %logger{36} - %msg %n
            </Pattern>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>TRACE</level>
        </filter>
    </appender>

    <root level="INFO">
        <appender-ref ref="consoleAppender" />
    </root>

    <logger name="com.cloudhopper.smpp.impl" level="ERROR" />
    <logger name="com.futreprocessing.spring" level="INFO" />
    <logger name="org.springframework.boot.actuate.audit.listener" level="ERROR" />
    <logger name="org.apache.http.client.protocol" level="ERROR" />

    <!-- Spring Web Service Payload Logging-->
    <logger name="org.springframework.ws.client.MessageTracing" level="TRACE" />
    <logger name="org.springframework.ws.server.MessageTracing" level="TRACE" />
</configuration>